{
  "name": "roboost",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "agent"],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/ws/src/roboost",
  "remoteUser": "ubuntu",
  "postCreateCommand": "bash -c 'source /opt/ros/jazzy/setup.bash && cd /ws && colcon build --symlink-install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "platformio.platformio-ide"
      ]
    }
  }
}
